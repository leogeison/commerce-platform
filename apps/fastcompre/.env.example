# Identificador público (`Site.slug`) do Site que este deployment de
# apps/fastcompre representa. Cada deployment serve exatamente um Site —
# resolução por hostname/domínio não existe nesta fase (WEB-001).
# Enviado como `:siteSlug` em toda chamada à API pública
# (`GET /public/sites/:siteSlug/...`).
SITE_SLUG="change-me-to-the-site-slug"

# URL base da API (apps/api). Server-only — nunca prefixado com NEXT_PUBLIC_,
# já que a WEB-001 é um cliente exclusivamente server-side (App Router).
API_URL="http://localhost:3000"

# Origem pública absoluta deste deployment (WEB-007) — usada para montar URLs
# absolutas (ex.: sitemap.xml). Apenas protocol://host[:port], sem path,
# query ou hash.
# Produção: SITE_URL="https://fastcompre.com.br"
SITE_URL="http://localhost:3001"

# Origem pública do endpoint de redirect de afiliado, GET /r/:siteSlug/:offerId
# (WEB-009) — separada de API_URL porque é renderizada em <a href> (precisa
# ser browser-facing), diferente de API_URL (uso exclusivamente server-side).
# Igual a API_URL em desenvolvimento; pode divergir em produção.
AFFILIATE_REDIRECT_URL="http://localhost:3000"

# Segredo compartilhado que autentica chamadas servidor-a-servidor (API ->
# FastCompre) ao endpoint interno de revalidação de cache. Gere um valor
# aleatório com pelo menos 16 caracteres, nunca reaproveite entre ambientes.
# Precisa ser exatamente o mesmo valor configurado do lado da API.
REVALIDATION_SECRET="change-me-to-a-random-secret-of-at-least-16-chars"

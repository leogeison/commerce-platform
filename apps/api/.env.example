# Connection string do PostgreSQL (Prisma). Preenchida de verdade na DB-003.
DATABASE_URL="postgresql://user:password@localhost:5432/commerce_platform"

# Segredo usado para hash do token de sessão opaca (Seção 15 do Architecture.md).
# Gere um valor aleatório com pelo menos 16 caracteres, nunca reaproveite entre ambientes.
SESSION_SECRET="change-me-to-a-random-secret-of-at-least-16-chars"

# Segredo compartilhado do endpoint interno de revalidação (Seção 21 do Architecture.md).
# Gere um valor aleatório com pelo menos 16 caracteres, nunca reaproveite entre ambientes.
REVALIDATION_SECRET="change-me-to-a-random-secret-of-at-least-16-chars"

# Origem exata do apps/admin — único valor aceito pelo CORS restritivo (INF-005,
# Seção 15 do Architecture.md). Ajuste para a porta em que o admin roda localmente.
ADMIN_ORIGIN="http://localhost:3001"

# Origem do deployment FastCompre chamado pelo adapter de revalidação
# (Seção 21 do Architecture.md) — POST {REVALIDATION_TARGET_URL}/api/internal/revalidate.
# Apenas protocol://host[:port], sem path/query/hash.
REVALIDATION_TARGET_URL="http://localhost:3001"

# Storage de upload de imagem (UPL-008/UPL-009, Seção 29 do Architecture.md) —
# via API S3, compatível com AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO etc.
#
# Para desenvolvimento local, `docker-compose.yml` sobe um MinIO (serviços
# `minio`/`minio-init`) já com o bucket abaixo criado e liberado para leitura
# anônima — os valores comentados de MinIO abaixo são exatamente os que esse
# MinIO local espera. Em produção, cada variável aponta para o provedor real
# (AWS S3, R2, Spaces etc.), decisão fora do escopo deste arquivo de exemplo.
STORAGE_S3_BUCKET="local-dev-bucket"
STORAGE_S3_REGION="auto"

# Base da URL pública usada para montar a resposta { url } do upload
# (STORAGE_S3_PUBLIC_URL_BASE + "/" + nome do arquivo) — a `S3StorageAdapter`
# NÃO insere o nome do bucket automaticamente, então para provedores em modo
# path-style (MinIO local, abaixo) o bucket precisa estar embutido aqui.
# Nem sempre é o mesmo domínio do endpoint de API (ex.: R2 costuma expor
# leitura pública em um domínio ".r2.dev" ou um CDN customizado).
STORAGE_S3_PUBLIC_URL_BASE="http://localhost:9000/local-dev-bucket"

# Opcional — só necessário para provedores que não são a AWS "de verdade"
# (R2, MinIO, Spaces). Ausente = SDK usa o endpoint padrão da AWS.
STORAGE_S3_ENDPOINT="http://localhost:9000"

# Opcional, "true"/"false" (default "false"). MinIO geralmente precisa de
# "true"; AWS/R2 geralmente não.
STORAGE_S3_FORCE_PATH_STYLE="true"

# Opcionais, mas ambas ou nenhuma. Ausentes, o AWS SDK usa sua cadeia padrão
# de credenciais (útil para S3 real com IAM) — o que, sem um provedor real
# configurado, falha com "CredentialsProviderError: Could not load
# credentials from any providers". Provedores S3-compatible que exigem
# credenciais explícitas (R2, MinIO, Spaces) precisam das duas; os valores
# abaixo são exatamente os do MinIO local do `docker-compose.yml`.
STORAGE_S3_ACCESS_KEY_ID="local-dev-access-key"
STORAGE_S3_SECRET_ACCESS_KEY="local-dev-secret-key-change-me"

# Connection string do PostgreSQL (Prisma). Preenchida de verdade na DB-003.
DATABASE_URL="postgresql://user:password@localhost:5432/commerce_platform"

# Segredo usado para hash do token de sessão opaca (Seção 15 do Architecture.md).
# Gere um valor aleatório com pelo menos 16 caracteres, nunca reaproveite entre ambientes.
SESSION_SECRET="change-me-to-a-random-secret-of-at-least-16-chars"

# Segredo compartilhado do endpoint interno de revalidação (Seção 21 do Architecture.md).
# Gere um valor aleatório com pelo menos 16 caracteres, nunca reaproveite entre ambientes.
REVALIDATION_SECRET="change-me-to-a-random-secret-of-at-least-16-chars"

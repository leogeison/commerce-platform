{
  "name": "commerce-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Commerce Platform — motor multi-marca de conteúdo e afiliação (FastCompre e futuras marcas).",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "dev:api": "node scripts/dev-api.mjs",
    "dev:admin": "pnpm --filter admin dev",
    "dev:fastcompre": "pnpm --filter fastcompre dev"
  },
  "devDependencies": {
    "@leogeison/eslint-config": "^0.1.1",
    "cross-spawn": "^7.0.6",
    "eslint": "^9.39.5",
    "tree-kill": "^1.2.2"
  }
}
